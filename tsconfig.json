{
	"compilerOptions": {
		// Environment Setup
		"lib": [
			"ESNext"
		],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"types": [
			"bun"
		],
		"paths": {
			"@": [
				"./src/index.ts"
			],
			"@/app": [
				"./src/app.ts"
			],
			"@/codegen/*": [
				"./src/codegen/*"
			],
			"@/utils/*": [
				"./src/utils/*"
			],
			"@/lib/*": [
				"./src/lib/*"
			],
			"@/modules/*": [
				"./src/modules/*"
			],
			"@/api/*": [
				"./src/component/api/*"
			],
			"@/bot/*": [
				"./src/component/bot/*"
			],
			"@/db/*": [
				"./src/component/db/*"
			],
			"@/error/*": [
				"./src/component/error/*"
			]
		},

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"strictNullChecks": true,

		"noUncheckedIndexedAccess": false, // this I find makes more problems than it solves
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,
		"noImplicitThis": false,
		"noImplicitReturns": false,

		"useUnknownInCatchVariables": true // see: https://www.typescriptlang.org/tsconfig#useUnknownInCatchVariables
	}
}
