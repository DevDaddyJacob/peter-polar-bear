root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = tab
indent_size = 4
max_line_length = 90
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
ij_typescript_spaces_within_imports = true
ij_typescript_use_import_type = auto
ij_typescript_import_use_node_resolution = true


# YAML forbids tabs, and Biome doesn't format these anyway.
[*.{yml,yaml}]
indent_style = space
indent_size = 4

# Markdown: tabs break nested lists, and trailing spaces are meaningful.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false