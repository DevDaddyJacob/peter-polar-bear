{
	"name": "peter-polar-bear",
	"version": "0.1.0",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git@github.com:DevDaddyJacob/peter-polar-bear.git"
	},
	"scripts": {
		"prepare": "husky && bun codegen",
		"codegen": "bun run codegen.ts",
		"precompile": "bun codegen",
		"compile": "bun run compile.ts",
		"check": "bunx --bun @biomejs/biome check --config-path=biome.json --max-diagnostics=none",
		"format": "bunx --bun @biomejs/biome format --write --config-path=biome.json --max-diagnostics=none",
		"lint": "bunx --bun @biomejs/biome lint --config-path=biome.json --max-diagnostics=none",
		"db-generate": "bunx --bun drizzle-kit generate",
		"local-build": "docker compose build",
		"local-reload": "docker compose up --detach --force-recreate",
		"local-run": "docker compose up --detach --build",
		"local-stop": "docker compose down",
		"image": "docker build --file Dockerfile --tag peter-polar-bear-discord-bot ."
	},
	"lint-staged": {
		"*.{js,ts}": [
			"echo ⋯Formatting code…",
			"bunx --bun @biomejs/biome format --write --config-path=biome.json",
			"echo ⋯Fixing imports…",
			"bunx --bun @biomejs/biome check --write --only=source/organizeImports --config-path=biome.json",
			"echo ⋯Linting code…",
			"bunx --bun @biomejs/biome lint --write --no-errors-on-unmatched --max-diagnostics=none --config-path=biome.json"
		],
		"*.{json,jsonc}": [
			"echo ⋯Formatting code…",
			"bunx --bun @biomejs/biome format --write --config-path=biome.json",
			"echo ⋯Linting code…",
			"bunx --bun @biomejs/biome lint --write --no-errors-on-unmatched --max-diagnostics=none --config-path=biome.json"
		],
		"migrations/**/*": []
	},
	"dependencies": {
		"@googleapis/drive": "20.2.0",
		"@googleapis/sheets": "13.0.2",
		"discord.js": "14.27.0",
		"dotenv": "17.4.2",
		"drizzle-orm": "1.0.0-rc.4",
		"googleapis-common": "8.0.3",
		"pg": "8.23.0",
		"pino": "10.3.1",
		"safe-stable-stringify": "2.5.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/bun": "1.4.0",
		"@types/pg": "8.23.1",
		"drizzle-kit": "1.0.0-rc.4",
		"husky": "9.1.7",
		"lint-staged": "17.1.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"engines": {
		"bun": "1.4.0"
	}
}
